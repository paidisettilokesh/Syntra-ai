# ============================================================
# Syntra AI Mail Agent — Environment Configuration Reference
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ============================================================

# ────────────────────────────────────────────────
# Application Settings
# ────────────────────────────────────────────────
POLL_INTERVAL=60           # Polling interval in seconds (10–3600)
DEBUG=False                # Enable debug mode
ENVIRONMENT=development    # development | production

# ────────────────────────────────────────────────
# Email Configuration (comma-separated for multiple accounts)
# ────────────────────────────────────────────────
EMAIL_USERS=email1@gmail.com,email2@gmail.com
EMAIL_PASSWORDS=app_password_1,app_password_2
IMAP_SERVER=imap.gmail.com

# ────────────────────────────────────────────────
# AI Providers (at least one required)
# ────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OLLAMA_BASE_URL=http://localhost:11434   # Optional: for local Ollama

# ────────────────────────────────────────────────
# Telegram Notifications
# ────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ────────────────────────────────────────────────
# Twilio WhatsApp Notifications (optional)
# ────────────────────────────────────────────────
# Set FEATURE_ENABLE_TWILIO=true to activate WhatsApp alerts
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
FROM_WHATSAPP_NUMBER=whatsapp:+14155238886
TO_WHATSAPP_NUMBER=whatsapp:+1234567890

# ────────────────────────────────────────────────
# Database
# ────────────────────────────────────────────────
DB_NAME=data/agent_logs.db

# ────────────────────────────────────────────────
# Monitoring and Logging
# ────────────────────────────────────────────────
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FILE=logs/agent.log           # Path to log file
LOG_MAX_BYTES=10485760            # 10 MB per log file
LOG_BACKUP_COUNT=5                # Number of rotated backups to keep
STRUCTURED_LOGGING=false          # Set to true for JSON log output

# ────────────────────────────────────────────────
# Email Verification Configuration
# ────────────────────────────────────────────────
ENABLE_EMAIL_VERIFICATION=true
ENABLE_AI_VERIFICATION=true
ENABLE_RULE_VERIFICATION=true
BLOCK_SUSPICIOUS_EMAILS=true
VERIFICATION_CONFIDENCE_THRESHOLD=80
ENABLE_TRUSTED_SENDERS=true
ENABLE_WEIGHTED_SCORING=true
ENABLE_SMART_AI_ROUTING=true
ENABLE_DETAILED_LOGGING=true
ALLOWLIST_FILE=data/trusted_domains.json

# ────────────────────────────────────────────────
# Feature Flags
# ────────────────────────────────────────────────
FEATURE_ENABLE_AI=true
FEATURE_ENABLE_OCR=true
FEATURE_ENABLE_TELEGRAM=true
FEATURE_ENABLE_TWILIO=false       # Set to true to enable WhatsApp alerts
FEATURE_ENABLE_CIRCUIT_BREAKER=true
FEATURE_ENABLE_SCHEDULER=true
FEATURE_ENABLE_HEALTH_MONITORING=true
FEATURE_ENABLE_DASHBOARD=true     # Issue #8: Web dashboard (http://localhost:8080)
FEATURE_ENABLE_ANALYTICS=true

# Dashboard port (default: 8080)
DASHBOARD_PORT=8080

# ────────────────────────────────────────────────
# Retention Policy
# ────────────────────────────────────────────────
RETENTION_DAYS_TO_KEEP=90         # Days to retain processed email logs
